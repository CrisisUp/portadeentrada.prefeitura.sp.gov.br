# .env.docker.example - Configurações para Docker
# Copie para .env e ajuste conforme necessário

# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# =============================================================================
# DATABASE (PostgreSQL no Docker)
# =============================================================================
# Formato: postgresql://user:password@host:port/database
# No docker-compose, o hostname é o nome do serviço: "postgres"
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/portadeentrada

# =============================================================================
# NEXTAUTH
# =============================================================================
# Gere um secret seguro: openssl rand -base64 32
NEXTAUTH_SECRET=your-super-secret-key-min-32-chars-change-in-production
NEXTAUTH_URL=http://localhost:3000

# =============================================================================
# SEED PASSWORDS (Opcional - para db:seed / db:reset)
# =============================================================================
# Senhas padrão: admin123
SEED_ADMIN_PASSWORD=admin123
SEED_EDITOR_PASSWORD=admin123
SEED_VIEWER_PASSWORD=admin123

# =============================================================================
# EXTERNAL SERVICES (Opcional)
# =============================================================================
# Upstash Redis (Rate limiting)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# =============================================================================
# DOCKER SPECIFIC
# =============================================================================
# Para build multi-platform (arm64/amd64)
# DOCKER_DEFAULT_PLATFORM=linux/amd64
