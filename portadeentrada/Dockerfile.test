# Dockerfile.test - Para rodar testes em CI/CD
# Uso: docker-compose -f docker-compose.test.yml up --abort-on-container-exit

FROM node:22-alpine AS test

# Instalar dependências do sistema (incluindo Chromium para Playwright)
RUN apk add --no-cache \
    openssl \
    libc6-compat \
    python3 \
    make \
    g++ \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    ttf-freefont \
    font-noto-emoji \
    git

# Configurar Playwright para usar Chromium do sistema
ENV PLAYWRIGHT_BROWSERS_PATH=/msw/playwright
ENV PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium

WORKDIR /app

# Habilitar corepack
RUN corepack enable

# Copiar package files
COPY package.json package-lock.json* ./

# Instalar TODAS as dependências
RUN npm ci --prefer-offline --no-audit --progress=false

# Instalar Playwright browsers (apenas Chromium já está no sistema)
# RUN npx playwright install --with-deps chromium

# Copiar Prisma
COPY prisma ./prisma/

# Gerar Prisma Client
RUN npx prisma generate

# Copiar código fonte
COPY . .

# Build da aplicação (necessário para E2E tests)
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# Expor porta para E2E tests
EXPOSE 3000

# Comando padrão - roda todos os testes
CMD ["sh", "-c", "npm run test:integration && npm run test:component && npm run test:e2e"]